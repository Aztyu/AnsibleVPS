---
services:
  gotify:
    image: gotify/server:{{ gotify_version }}
    labels:
      kuma.gotify.http.name: "Gotify"
      kuma.gotify.http.url: "https://gotify.corentinbeal.fr"
    ports:
      - 8888:80
    environment:
      GOTIFY_DEFAULTUSER_PASS: '{{ gotify_password }}'
    volumes:
      - './gotify_data:/app/data'
    restart: unless-stopped
    # to run gotify as a dedicated user:
    # sudo chown -R 1234:1234 ./gotify_data
    # user: "1234:1234"