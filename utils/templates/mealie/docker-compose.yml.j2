---
services:
  mealie:
    image: ghcr.io/mealie-recipes/mealie:{{ mealie_version }}
    container_name: mealie
    restart: always
    ports:
      - "9925:9000"
    deploy:
      resources:
        limits:
          memory: 1000M
    volumes:
      - mealie-data:/app/data/
    environment:
      # Set Backend ENV Variables Here
      ALLOW_SIGNUP: "false"
      PUID: 1000
      PGID: 1000
      TZ: Europe/Rome
      BASE_URL: https://mealie.corentinbeal.fr

volumes:
  mealie-data: