provider:
  name: docker
  docker:
    strategy: stop
server:
  port: 10000
  base-path: /
storage:
  file:
sessions:
  default-duration: 60m
  expiration-interval: 5m
logging:
  level: info
strategy:
  dynamic:
    custom-themes-path:
    show-details-by-default: true
    default-theme: shuffle
    default-refresh-frequency: 5s
  blocking:
    default-timeout: 1m