---
services:
  gluetun:
    image: qmcgaw/gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=airvpn
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY={{ gluetun_wireguard_private_key }}
      - WIREGUARD_PRESHARED_KEY={{ gluetun_wireguard_preshared_key }}
      - WIREGUARD_ADDRESSES={{ gluetun_wireguard_addresses }}
      - FIREWALL_VPN_INPUT_PORTS={{ vpn_open_port }}
      - SERVER_COUNTRIES=Germany
    ports:
      - ${PORT:-8191}:8191
      - 9696:9696
      # Transmission web UI (host 9092 -> container 9091)
      - 9092:9091
      # Open ports
      - {{ vpn_open_port }}:{{ vpn_open_port }}/tcp
      - {{ vpn_open_port }}:{{ vpn_open_port }}/udp
    restart: unless-stopped

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    labels:
      kuma.prowlarr.http.name: "Prowlarr"
      kuma.prowlarr.http.url: "https://prowlarr.corentinbeal.fr"
    environment:
      - TZ=Etc/UTC
    volumes:
      - {{ dockge_base_folder }}torrent-stack/data:/config
    restart: unless-stopped
    network_mode: "service:gluetun"

  flaresolverr:
    # DockerHub mirror flaresolverr/flaresolverr:latest
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr1
    environment:
      - LOG_LEVEL=${LOG_LEVEL:-info}
      - LOG_HTML=${LOG_HTML:-false}
      - CAPTCHA_SOLVER=${CAPTCHA_SOLVER:-none}
      - TZ=Europe/London
    restart: unless-stopped
    network_mode: "service:gluetun"

  transmission:
    image: lscr.io/linuxserver/transmission:{{ transmission_version }}
    container_name: transmission
    labels:
      kuma.transmission-gluetun.http.name: "Transmission (Gluetun)"
      kuma.transmission-gluetun.http.url: "http://transmission-gluetun.corentinbeal.fr"
      # Caddy protects this endpoint with basic auth, so a 401 means the full chain is up
      kuma.transmission-gluetun.http.accepted_statuscodes: '["200-399","401"]'
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Paris
    volumes:
      - {{ dockge_base_folder }}transmission-gluetun/config:/config
      - /mnt/storagebox/media/:/downloads
      - /mnt/storagebox/media/incomplete-gluetun:/downloads/incomplete
      - /mnt/storagebox/media/watch-gluetun:/watch
    restart: unless-stopped
    network_mode: "service:gluetun"