[Unit]
Description=Radarr Daemon
# network-online : Radarr doit pouvoir joindre les indexers/notifications au demarrage
# mnt-storagebox : la bibliotheque vit sous /mnt/storagebox (montage rclone)
After=syslog.target network-online.target mnt-storagebox.service
Wants=network-online.target

[Service]
Type=simple

ExecStart=/opt/Radarr/Radarr -nobrowser -data=/var/lib/radarr/
TimeoutStopSec=20
KillMode=process
Restart=on-failure
[Install]
WantedBy=multi-user.target
